{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "Digital menu and profile for a restaurant venue",
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "description": "Unique URL identifier for the restaurant",
          "minLength": 2,
          "maxLength": 64,
          "pattern": "^[a-z0-9_-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the restaurant proprietor",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Public display name of the restaurant",
          "minLength": 1,
          "maxLength": 100
        },
        "whatsapp": {
          "type": "string",
          "description": "WhatsApp contact number with country code for orders",
          "maxLength": 30
        },
        "offer": {
          "type": "string",
          "description": "Special promotion banner or welcome offer",
          "maxLength": 200
        },
        "address": {
          "type": "string",
          "description": "Physical address or venue location",
          "maxLength": 200
        },
        "hours": {
          "type": "string",
          "description": "Operating hours of the establishment",
          "maxLength": 100
        },
        "instagram": {
          "type": "string",
          "description": "Instagram profile link or handle",
          "maxLength": 200
        },
        "facebook": {
          "type": "string",
          "description": "Facebook profile link or handle",
          "maxLength": 200
        },
        "heroImage": {
          "type": "string",
          "description": "Hero banner photo URL",
          "maxLength": 1000
        },
        "story": {
          "type": "string",
          "description": "Background story and culinary philosophy",
          "maxLength": 1000
        },
        "currency": {
          "type": "string",
          "description": "Selected currency symbol or code (e.g. Rs., $, €, £, AED)",
          "maxLength": 20
        },
        "items": {
          "type": "array",
          "description": "List of dishes and drinks available on the menu"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update",
          "maxLength": 60
        }
      },
      "required": ["slug", "ownerUid", "name", "items"]
    },
    "RatingReview": {
      "title": "RatingReview",
      "description": "Guest feedback or rating review for a restaurant or dish",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique rating document identifier",
          "minLength": 1,
          "maxLength": 128
        },
        "slug": {
          "type": "string",
          "description": "Restaurant slug this review pertains to",
          "minLength": 2,
          "maxLength": 64
        },
        "uid": {
          "type": "string",
          "description": "Author UID or client ID",
          "minLength": 1,
          "maxLength": 128
        },
        "itemKey": {
          "type": "string",
          "description": "restaurant or specific item id",
          "minLength": 1,
          "maxLength": 64
        },
        "stars": {
          "type": "number",
          "description": "Score from 1 to 5"
        },
        "comment": {
          "type": "string",
          "description": "Diner written review comment",
          "maxLength": 500
        },
        "name": {
          "type": "string",
          "description": "Display name of reviewer",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of review submission",
          "maxLength": 60
        }
      },
      "required": ["id", "slug", "uid", "itemKey", "stars"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantSlug}": {
      "schema": "Restaurant",
      "description": "Collection of all restaurant menus keyed by unique slug"
    },
    "/restaurants/{restaurantSlug}/ratings/{ratingId}": {
      "schema": "RatingReview",
      "description": "Customer ratings and guest reviews for dishes or the restaurant"
    }
  }
}
