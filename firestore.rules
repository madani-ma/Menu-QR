rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helper for Restaurant documents
    function isValidRestaurant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 60
        && data.whatsapp is string && data.whatsapp.size() <= 30
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && (!('offer' in data) || (data.offer is string && data.offer.size() <= 200))
        && (!('address' in data) || (data.address is string && data.address.size() <= 250))
        && (!('hours' in data) || (data.hours is string && data.hours.size() <= 150))
        && (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 200))
        && (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 200))
        && (!('heroImage' in data) || (data.heroImage is string && data.heroImage.size() <= 200000))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 200000))
        && (!('story' in data) || (data.story is string && data.story.size() <= 2000))
        && (!('items' in data) || data.items is list);
    }

    // Validation helper for Rating documents
    function isValidRating(data, uid) {
      return data.uid is string && data.uid == uid
        && data.stars is int && data.stars >= 1 && data.stars <= 5
        && data.itemKey is string && data.itemKey.size() <= 64
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 200))
        && (!('name' in data) || (data.name is string && data.name.size() <= 60))
        && (!('createdAt' in data) || data.createdAt is string);
    }

    // Restaurants collection
    match /restaurants/{slug} {
      // Anyone can read restaurant info
      allow read: if true;

      // Only authenticated restaurant owner can create
      allow create: if request.auth != null 
        && request.resource.data.ownerUid == request.auth.uid
        && isValidRestaurant(request.resource.data);

      // Only verified owner can update their own restaurant
      allow update: if request.auth != null 
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && isValidRestaurant(request.resource.data);

      // Only the owner can delete
      allow delete: if request.auth != null 
        && resource.data.ownerUid == request.auth.uid;

      // Subcollection: Ratings and Reviews
      match /ratings/{ratingId} {
        // Anyone can read ratings
        allow read: if true;

        // Any authenticated user (including anonymous) can create/update their rating
        allow create, update: if request.auth != null
          && request.auth.uid == request.resource.data.uid
          && ratingId.matches('^' + request.auth.uid + '.*')
          && isValidRating(request.resource.data, request.auth.uid);

        // Delete allowed for the review author OR the restaurant owner
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/restaurants/$(slug)).data.ownerUid == request.auth.uid
        );
      }
    }
  }
}
