rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation blueprint for Restaurant
    function isValidRestaurant(data) {
      return data.keys().hasAll(['slug', 'ownerUid', 'name', 'items']) &&
        data.slug is string && isValidId(data.slug) && data.slug.size() >= 2 && data.slug.size() <= 64 &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 30)) &&
        (!('offer' in data) || (data.offer is string && data.offer.size() <= 250)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 250)) &&
        (!('hours' in data) || (data.hours is string && data.hours.size() <= 150)) &&
        (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 250)) &&
        (!('facebook' in data) || (data.facebook is string && data.facebook.size() <= 250)) &&
        (!('heroImage' in data) || (data.heroImage is string && data.heroImage.size() <= 1500)) &&
        (!('story' in data) || (data.story is string && data.story.size() <= 1500)) &&
        (!('currency' in data) || (data.currency is string && data.currency.size() <= 20)) &&
        data.items is list && data.items.size() <= 150 &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    // Validation blueprint for RatingReview
    function isValidRating(data) {
      return data.keys().hasAll(['id', 'slug', 'stars', 'uid', 'itemKey']) &&
        data.id is string && isValidId(data.id) && data.id.size() <= 128 &&
        data.slug is string && isValidId(data.slug) && data.slug.size() <= 64 &&
        data.uid is string && data.uid.size() <= 128 &&
        data.itemKey is string && data.itemKey.size() <= 64 &&
        data.stars is number && data.stars >= 1 && data.stars <= 5 &&
        (!('comment' in data) || (data.comment is string && data.comment.size() <= 500)) &&
        (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60));
    }

    // Connection validation probe document
    match /test/{testId} {
      allow get: if true;
    }

    // Main restaurant documents
    match /restaurants/{restaurantSlug} {
      // Diners who scan the QR code should be able to view the menu without logging in
      allow get: if isValidId(restaurantSlug);

      // Authenticated owners listing only their own restaurants
      allow list: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Only authenticated owner can create their own menu
      allow create: if isSignedIn() &&
        isValidId(restaurantSlug) &&
        restaurantSlug == incoming().slug &&
        request.auth.uid == incoming().ownerUid &&
        isValidRestaurant(incoming());

      // Only the logged-in owner can edit their own menu, with ownership and slug locked
      allow update: if isSignedIn() &&
        isValidId(restaurantSlug) &&
        request.auth.uid == existing().ownerUid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().slug == existing().slug &&
        isValidRestaurant(incoming());

      // Only the owner can delete their restaurant (or clean up if absent)
      allow delete: if isSignedIn() &&
        isValidId(restaurantSlug) &&
        (resource == null || request.auth.uid == resource.data.ownerUid);

      // Subcollection for diner ratings and reviews
      match /ratings/{ratingId} {
        // Diners can view reviews
        allow get, list: if isValidId(restaurantSlug);

        // Diners can submit ratings for existing restaurants
        allow create: if isValidId(restaurantSlug) &&
          isValidId(ratingId) &&
          exists(/databases/$(database)/documents/restaurants/$(restaurantSlug)) &&
          incoming().slug == restaurantSlug &&
          isValidRating(incoming());

        // Rating author can update their review
        allow update: if isValidId(restaurantSlug) &&
          isValidId(ratingId) &&
          isValidRating(incoming()) &&
          incoming().slug == restaurantSlug &&
          ((isSignedIn() && request.auth.uid == existing().uid) ||
           (!isSignedIn() && incoming().uid == existing().uid));

        // Rating author or restaurant owner can delete the review
        allow delete: if isValidId(restaurantSlug) &&
          isValidId(ratingId) &&
          (
            (isSignedIn() && request.auth.uid == existing().uid) ||
            (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/restaurants/$(restaurantSlug)).data.ownerUid)
          );
      }
    }
  }
}
